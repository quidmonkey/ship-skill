
# --- Shipping (/ship, make ship) -------------------------------------------------
# Appended from the ship skill (~/.claude/skills/ship/codereviewrc.ship).

# Max times one ship commits an auto-fix and pushes again
# (non-negative integer). No confirmation: the ship's worktree is its own, and
# each re-push runs the full review again. By then the fix_max_iterations loop
# above has already converged the fix, so more than one retry is only needed
# if the fresh commit's full review turns up something new. A plain
# `git push` never commits or retries on its own.
ship_fix_retries=1

# ship.sh snapshots the branch, reviews and pushes it from its own worktree
# (../<repo>.ship-<id>), then goes as far as ship_stage. It targets develop
# unless the ship names another branch. Stages are cumulative:
#   push           stop after the push
#   open_pr        open a PR from the snapshot branch into develop
#   merge          also self-approve, arm auto-merge, and wait for the merge
#   verify_deploy  also wait for the dev deploy, check health, run the smoke test
# `make ship-stage STAGE=<stage>` rewrites this line.
ship_stage=open_pr

# Days to keep finished ship logs in .git/ship/; 0 keeps them forever.
ship_log_retention_days=30

# none | desktop (desktop notification on macOS, Windows or Linux when the ship finishes)
ship_notify=none

# CLI used to open/approve/merge the PR: gh | az. Auto-detected from
# `git remote get-url origin` when unset (github.com -> gh, anything else ->
# az). Set explicitly only to override detection.
# pr_host=gh

# Reviewers added to the PR, comma-separated. Empty adds none.
# GitHub: usernames or org/team. ADO: emails/UPNs or [Project]\Team (added as
# optional). At merge and above the PR is approved and auto-completed right
# away, so named reviewers may never see it.
pr_reviewers=

# Merge method used when auto-merge completes: squash | merge | rebase
pr_merge_method=squash

# Self-approve the PR before arming auto-merge. Best-effort: a host that
# rejects a self-review makes this a no-op, and auto-merge waits for a human
# reviewer instead of failing the ship.
pr_self_approve=true

# How the merge stage waits: poll every pr_poll_interval seconds, up to
# pr_poll_timeout seconds. Past the timeout the ship fails with auto-merge
# still armed. verify_deploy polls at the same interval.
pr_poll_interval=15
pr_poll_timeout=1800

# --- verify_deploy (dev only) ----------------------------------------------------
# ADO pipeline name or ID, or GitHub workflow name, that deploys develop.
deploy_pipeline=
# cloud_run | agent_runtime (agent_engine, its earlier name, also works)
deploy_provider=
# Dev GCP project ID.
deploy_project=
deploy_region=us-central1
# Cloud Run service name, or Agent Runtime display name.
deploy_name=
# How to tell the deploy is this commit: sha | time (default time).
#   sha: the Cloud Run revision is <service>-<sha12> or has a commit=<sha12>
#        label, or the Agent Runtime has a commit=<sha12> label. The deploy has
#        to tag it (a scaffold question).
#   time: the revision or engine was created/updated after the run started.
deploy_match=
# Cloud Run only: smoke-test through `gcloud run services proxy` (for private
# services, where user credentials can't mint an ID token).
deploy_proxy=false
# Smoke test command, run in the ship's worktree with DEPLOY_URL,
# DEPLOY_RESOURCE and DEPLOY_SHA set. Its exit code decides the result, so it
# must fail when it can't reach the target: set its require-live flag.
# e.g. uv run pytest tests/integration
deploy_smoke=
# Seconds to wait for the pipeline run to appear. None means the pipeline's
# path filters excluded the change: the stage is skipped, the ship passes.
deploy_run_grace=300
deploy_poll_timeout=3600
deploy_smoke_timeout=900
