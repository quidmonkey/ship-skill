# Personal settings for the ship skill (/ship), kept out of git by
# .git/info/exclude. The ship created this file from
# ~/.claude/skills/ship/shiprc.template; its docs/reference.md describes every
# key. Format: key=value, one per line, no quotes.
#
# Any key can be overridden for one run without editing this file:
#   /ship merge review_model=sonnet   (or make ship SET='review_model=sonnet;ship_stage=merge')
#   CR_REVIEW_MODEL=sonnet            (CR_ + the key in uppercase)
# An empty override means the built-in default. An unknown key fails the run.

# --- Review ----------------------------------------------------------------------
# Uncomment to change a default.
# review_model=opus            # pass 1, the general review
# review_effort=high           # low | medium | high | xhigh | max | default
# fix_max_iterations=2         # auto-fix rounds after a failed review; 0 turns auto-fix off
# agent_timeout=900            # seconds per agent call

# --- Shipping ------------------------------------------------------------------------

# ship.sh snapshots the branch, reviews and pushes it from its own worktree
# (../<repo>.ship-<id>), then goes as far as ship_stage. It targets develop
# unless the ship names another branch. Stages are cumulative:
#   push           stop after the push
#   open_pr        open a PR from the snapshot branch into develop
#   merge          also self-approve, arm auto-merge, and wait for the merge
#   verify_deploy  also run deploy_check against the deploy of the merge commit
# `make ship-stage STAGE=<stage>` rewrites this line.
ship_stage=open_pr

# Command run in a new ship worktree before the review, so the fixer and the
# repo's hooks have its dependencies; none runs nothing. The first ship detects
# it and fix_checks from the repo's CI config and writes both at the end of this
# file. Without that, it defaults to uv sync -q when the repo has a
# pyproject.toml, otherwise nothing. e.g. npm ci
# ship_setup=

# Lint and test commands, separated by ;. The reviewers may run
# them to confirm a finding, and the fix agent runs them to check its work.
# Each one is a single command, run as written. Detected on the first ship;
# without that, defaults to uv run pre-commit;uv run pytest with a
# pyproject.toml, otherwise none. e.g. npm run lint;npm test
# fix_checks=

# The files and directories that state the project's intended behavior, space-separated. The review checks
# changes against them and ranks them above tests, and tests above code.
# auto takes whichever of docs, doc, ARCHITECTURE.md, DESIGN.md and README.md
# exist; none means the project has no such documents. e.g. specs/ ADR.md
# review_docs=auto

# none | desktop (desktop notification on macOS, Windows or Linux when the ship finishes)
ship_notify=none

# CLI used to open/approve/merge the PR: gh | az. Auto-detected from
# `git remote get-url origin` when unset (github.com -> gh, anything else ->
# az). Set explicitly only to override detection.
# pr_host=gh

# Reviewers added to the PR, comma-separated. Empty adds none.
# GitHub: usernames or org/team. ADO: emails/UPNs or [Project]\Team (added as
# optional). At merge and above the PR is approved and auto-completed right
# away, so named reviewers may never see it.
pr_reviewers=

# Merge method used when auto-merge completes: squash | merge | rebase.
# A prod release always uses a merge commit, so main and develop stay in step.
pr_merge_method=squash

# Self-approve the PR before arming auto-merge. Best-effort: a host that
# rejects a self-review makes this a no-op, and auto-merge waits for a human
# reviewer instead of failing the ship.
pr_self_approve=true

# Seconds the merge stage waits for the PR to merge. Past it the ship fails
# with auto-merge still armed.
pr_poll_timeout=1800

# --- verify_deploy -------------------------------------------------------------
# Command run after the merge, in the ship's worktree (the checkout for a prod
# release), with DEPLOY_SHA (the merge commit) and DEPLOY_BRANCH (the target
# branch) set. It waits for that commit's deploy and checks it, and its exit
# status is the result: 0 passes, anything else fails the ship. It must fail
# when it can't reach the deploy. e.g. ./scripts/check-deploy.sh
deploy_check=
# Seconds deploy_check may run before it's stopped and the ship fails.
deploy_timeout=3600
